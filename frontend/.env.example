# LifeLink Frontend Environment Variables
# In local development, leave this empty to use the Vite dev server proxy (/api -> http://localhost:8080)
# In production on Vercel, set this to your Render backend URL (e.g., https://lifelink-backend.onrender.com)
VITE_API_BASE_URL=https://lifelink-backend.onrender.com

# Optional: WebSocket endpoint URL (if different from VITE_API_BASE_URL)
# VITE_WS_BASE_URL=wss://lifelink-backend.onrender.com/ws
